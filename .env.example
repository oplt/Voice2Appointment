# Database
DATABASE_URL=postgresql://voice_asst:changeme@localhost:5432/voice_asst
DB_HOST=localhost
DB_PORT=5432
DB_NAME=voice_asst
DB_USER=voice_asst
DB_PASSWORD=changeme

# App
SECRET_KEY=change-me-to-a-long-random-string
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=
# development | production — production forces DEBUG=false
APP_ENV=development
DEBUG=false
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Mail (password reset)
EMAIL_USER=
EMAIL_PASSWORD=

# Google Calendar OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/settings/google/callback
GOOGLE_CALENDAR_EMBEDDED_URL=

# Public base URL for webhooks (ngrok / production)
PUBLIC_BASE_URL=http://localhost:8000

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Deepgram
DEEPGRAM_API_KEY=
# eu | us | global — empty derives from DEFAULT_TIMEZONE (Europe/* → eu)
DEEPGRAM_REGION=
DEEPGRAM_MODEL=nova-3
DEEPGRAM_LANGUAGE=en
# Optional override of the agent WebSocket URL
DEEPGRAM_AGENT_URL=

# Redis / Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Observability (Phase 13)
LOG_FORMAT=json
# Optional — leave empty to disable Sentry
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0
