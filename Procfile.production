# Production-style process split (Honcho / Heroku-like).
# Local day-to-day: use Procfile (combined API+WS for convenience).

web: cd backend && PYTHONPATH=. ../.venv/bin/gunicorn asgi:app -k uvicorn.workers.UvicornWorker -b 0.0.0.0:8000 --workers 2
voice: cd backend && PYTHONPATH=. ../.venv/bin/uvicorn voice_asgi:app --host 0.0.0.0 --port 8001
worker: cd backend && PYTHONPATH=. ../.venv/bin/celery -A app.workers.celery_app.celery_app worker --loglevel=INFO
beat: cd backend && PYTHONPATH=. ../.venv/bin/celery -A app.workers.celery_app.celery_app beat --loglevel=INFO
